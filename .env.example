# Server-only values. Copy to .env.local for local testing; configure the same
# variables in Vercel for production, then redeploy. Never use VITE_ for secrets.
NODE_OPTIONS=--experimental-require-module
FIREBASE_SERVICE_ACCOUNT=
SERPAPI_API_KEY=
SITE_URL=https://www.shopfrom23.com
CRON_SECRET=
GROWTH_ADMIN_EMAILS=kehindeadeleke92@gmail.com
# Optional trusted Firebase UID allowlist, useful for an additional owner:
GROWTH_ADMIN_UIDS=
RESEARCH_DAILY_LIMIT=2
# Set true only after applying and testing the access rules in GROWTH_SETUP.md.
GROWTH_STORAGE_READY=false
